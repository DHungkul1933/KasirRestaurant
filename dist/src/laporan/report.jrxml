	<queryString language="SQL">
		<![CDATA[SELECT transaksi.Id_transaksi as "Id Transaksi",transaksi.Tanggal_transaksi as "Tanggal",karyawan.Kode_karyawan as "Kode Karyawan",karyawan.Nama_karyawan as "Nama Karyawan", 
                         makanan.Nama_Makanan as "Pesanan",makanan.Harga as "Harga",transaksi.Jumlah as "Jumlah", transaksi.total_harga  as "Total"
                         FROM transaksi  
                         INNER JOIN karyawan on karyawan.Id_karyawan = transaksi.Id_karyawan 
                         INNER JOIN makanan ON makanan.Id_Makanan = transaksi.Id_Makanan]]>
	</queryString>
